        "instructions": [
            {
                "content": "Log in to IMPACT in a single browser window at a time (but if you would like your co-authors to review the article as well, please share it with them by selecting the sharing option in IMPACT).",
                "allowedclient": ["medknow", "plos"]
            },
            {
                "content": "Review your proof carefully, making any necessary amendments directly into the article.",
                "allowedclient": ["medknow", "plos"]
            },
            {
                "content": "Save your changes if you want to pause reviewing and use the logout option before closing the browser window. You may log in again later to resume reviewing using your log-in link.",
                "allowedclient": ["medknow", "plos"]
            },
            {
                "content": "Only finish your review in IMPACT when you are sure you have no additional changes to add as the review will be closed and not be accessible after reviewing has been completed.",
                "allowedclient": ["medknow", "plos"]
            },
            {
                "content": "Note that the images in IMPACT are low resolution to optimize the performance of the tool.",
                "allowedclient": ["medknow", "plos"]
            },
            {
                "content": "Submit the article when you have reviewed the entire article and resolved all author queries.",
                "allowedclient": ["medknow", "plos"]
            },
            {
                "content": "You will receive a copy of the proof with your changes tracked via email for your own records.",
                "allowedclient": ["medknow", "plos"]
            },
            {
                "content": "Take a thorough look at your proof and make any necessary modifications directly within the reports or article.",
                "allowedclient": ["default"]
            },
            {
                "content": "It should be noted that the images in IMPACT have a low resolution to enhance the performance of the tool.",
                "allowedclient": ["default"]
            },
            {
                "content": "Once you have reviewed the entire report and resolved all author queries, submit the article.",
                "allowedclient": ["default"]
            },
            {
                "content": "An email will be sent to you with a copy of the proof containing your tracked changes for your own records.",
                "allowedclient": ["default"]
            }
        ],
